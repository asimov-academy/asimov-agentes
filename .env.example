# Gerado pelo setup. Nunca commite o .env. Permissão 600.

# empresa: agentes só da própria empresa. revenda: agentes para empresas clientes.
MODO_INSTALACAO=

DOMINIO_BASE=
SUBDOMINIO_BOT=
EMAIL_SSL=
AGENTE_CODIGO=

POSTGRES_USER=asimov
POSTGRES_PASSWORD=
POSTGRES_DB=asimov

CHAVE_API_ADMIN=
CHAVE_CRIPTOGRAFIA=

# Modelos padrão por função, no formato provedor:modelo (openai, anthropic, gemini, groq).
MODELO_CONVERSA=
MODELO_FALLBACK=
MODELO_VISAO=
MODELO_TRANSCRICAO=
# Extras do SDK instalados na imagem, separados por espaço (derivado dos modelos).
PROVEDORES=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

LOG_NIVEL=INFO
